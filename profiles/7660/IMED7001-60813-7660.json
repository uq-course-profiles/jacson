    "learning_outcomes": [
        {
            "number": "LO1.",
            "description": "Apply detailed and integrated knowledge of skin anatomy, histology, physiology, dermatopathology, oncology, dermatoscopy, and epidemiology within an interdisciplinary skin cancer medical context."
        },
        {
            "number": "LO2.",
            "description": "Critically evaluate and interpret dermatological and dermatopathological data and published literature using foundational research principles to support evidence-based diagnosis and treatment decisions."
        },
        {
            "number": "LO3.",
            "description": "Collaborate with other members of healthcare teams, participating in professional, therapeutic interactions and applying relevant ethical and legal frameworks to achieve equitable and improved health outcomes."
        },
        {
            "number": "LO4.",
            "description": "Recognise cultural, social, and ethical dimensions in skin cancer care—particularly in diverse populations—and integrate respectful, equitable practices into patient-centred diagnosis and management."
        },
        {
            "number": "LO5.",
            "description": "Communicate dermatoscopic, histopathological, and clinical findings effectively to peers, patients, and professionals, using precise and appropriate terminology and reasoning."
        },
        {
            "number": "LO6.",
            "description": "Demonstrate professional leadership through ethical and responsible practice, working collaboratively and upholding standards expected of modern medical practitioners."
        }
    ],
